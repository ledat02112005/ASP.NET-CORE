<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - SportsStore Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="bg-dark text-white p-2">
        <div class="container-fluid d-flex justify-content-between align-items-center">
            <span class="navbar-brand text-white">SportsStore – Admin</span>
            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-sm btn-outline-light" href="/">Về trang chủ</a>
                @if (Context.User.Identity?.IsAuthenticated == true)
                {
                    <form asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="/" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-danger">Đăng xuất</button>
                    </form>
                }
            </div>
        </div>
    </header>

    <div class="container mt-3">
        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container">
            &copy; 2026 - SportsStore Admin
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
